	               {% endif %}--catalog=$(CATALOG) \
	               --ontology=$< \
	               --infile=$(PATTERNDIR)/data/default \
	               --template=$(PATTERNDIR)/dosdp-patterns \
	               --batch-patterns="$(DOSDP_PATTERN_NAMES_DEFAULT)" \
	               {% if project.repo_url -%}
	               --data-location-prefix={{ project.repo_url }}/src/patterns/data/default \
	               {% elif project.github_org and project.repo -%}
	               --data-location-prefix=https://github.com/{{ project.github_org -}}
	                                                        /{{ project.repo -}}
	                                                        /tree/{{ project.git_main_branch -}}
	                                                        /src/patterns/data/default \
	               {% endif -%}
	               --outfile=$(DOCSDIR)/patterns/default

{%   if project.pattern_pipelines_group is defined -%}
{%     for pipeline in project.pattern_pipelines_group.products -%}
# DOSDP {{ pipeline.id }} pipeline
{% set PID = pipeline.id.upper() -%}

